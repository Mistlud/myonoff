<Window x:Class="MyOnOff.DesktopController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyOnOff" Width="560" Height="440" MinWidth="520" MinHeight="410"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Host PC" FontSize="26" FontWeight="SemiBold" />
                <TextBlock x:Name="LastRefreshText" Text="Not checked yet" Foreground="#667085" Margin="0,3,0,0" />
            </StackPanel>
            <Button DockPanel.Dock="Right" x:Name="SettingsButton" Content="Settings" Click="Settings_Click"
                    MinWidth="92" HorizontalAlignment="Right" />
        </DockPanel>

        <Border Grid.Row="1" Margin="0,22,0,18" Padding="18" CornerRadius="10"
                Background="White" BorderBrush="#D0D5DD" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusIndicator" Width="18" Height="18" Fill="#98A2B3" Margin="0,0,12,0" />
                <TextBlock x:Name="StatusText" Text="UNKNOWN" FontSize="24" FontWeight="Bold" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Padding="18" CornerRadius="10" Background="White"
                BorderBrush="#D0D5DD" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="IP" FontWeight="SemiBold" Margin="0,4" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="IpText" Margin="0,4" />
                <TextBlock Grid.Row="1" Text="Agent" FontWeight="SemiBold" Margin="0,4" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AgentText" Margin="0,4" />
                <TextBlock Grid.Row="2" Text="SMB" FontWeight="SemiBold" Margin="0,4" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="SmbText" Margin="0,4" />
                <TextBlock Grid.Row="3" Text="Latency" FontWeight="SemiBold" Margin="0,4" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="LatencyText" Margin="0,4" />
                <TextBlock Grid.Row="4" Text="Details" FontWeight="SemiBold" Margin="0,4" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="DetailsText" Margin="0,4"
                           TextWrapping="Wrap" Foreground="#475467" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="-4,18,-4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="OnButton" Content="ON" Click="On_Click"
                    FontWeight="Bold" Background="#D1FADF" />
            <Button Grid.Column="1" x:Name="SleepButton" Content="Sleep" Click="Sleep_Click"
                    FontWeight="Bold" Background="#FEF0C7" IsEnabled="False" />
            <Button Grid.Column="2" x:Name="ShutdownButton" Content="Shutdown" Click="Shutdown_Click"
                    FontWeight="Bold" Background="#FEE4E2" IsEnabled="False" />
        </Grid>

        <TextBlock Grid.Row="4" Margin="0,10,0,0" Foreground="#667085" FontSize="12"
                   Text="ONLINE means both the Host Agent and SMB port 445 are ready." />
    </Grid>
</Window>
