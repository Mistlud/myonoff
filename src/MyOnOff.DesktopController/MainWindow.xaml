<Window x:Class="MyOnOff.DesktopController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyOnOff" Width="580" Height="600" MinWidth="520" MinHeight="540"
        WindowStartupLocation="CenterScreen" Background="#F5F6F8"
        FontFamily="Segoe UI" Foreground="#101828" Icon="Assets/MyOnOff.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid>
        <Grid x:Name="NormalModePanel" Margin="26,22,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/MyOnOff.ico" Width="38" Height="38" Margin="0,0,12,0" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="MyOnOff" FontSize="19" FontWeight="SemiBold" />
                    <TextBlock Text="Host PC control" Style="{StaticResource SecondaryText}" Margin="0,2,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="EasyModeButton" Content="Easy Mode" Click="EasyMode_Click"
                            Style="{StaticResource ToolbarButton}" MinWidth="90" Margin="0,0,8,0" />
                    <Button x:Name="SettingsButton" Content="Settings" Click="Settings_Click"
                            Style="{StaticResource ToolbarButton}" MinWidth="82" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,20,0,18" Style="{StaticResource SurfaceBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusIndicator" Width="12" Height="12" Fill="#98A2B3"
                             Margin="0,4,12,0" VerticalAlignment="Top" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="CURRENT STATE" Style="{StaticResource SectionHeading}" />
                        <TextBlock x:Name="StatusText" Text="UNKNOWN" FontSize="30" FontWeight="SemiBold"
                                   Margin="0,4,0,0" />
                        <TextBlock x:Name="DetailsText" Text="Checking the host status."
                                   TextWrapping="Wrap" Foreground="#475467" Margin="0,6,18,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Right">
                        <TextBlock x:Name="IpText" Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="LastRefreshText" Text="Not checked yet" Foreground="#98A2B3"
                                   FontSize="11" HorizontalAlignment="Right" Margin="0,3,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2">
                <TextBlock Text="POWER" Style="{StaticResource SectionHeading}" Margin="2,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="OnButton" Content="ON / Wake" Click="On_Click"
                            Style="{StaticResource PrimaryActionButton}" />
                    <Button Grid.Column="2" x:Name="SleepButton" Content="Sleep" Click="Sleep_Click"
                            Style="{StaticResource SecondaryActionButton}" IsEnabled="False" />
                    <Button Grid.Column="4" x:Name="ShutdownButton" Content="Shutdown" Click="Shutdown_Click"
                            Style="{StaticResource DangerActionButton}" IsEnabled="False" />
                </Grid>
            </StackPanel>

            <Expander Grid.Row="3" Header="Connection details" IsExpanded="False"
                      Margin="0,18,0,0" Foreground="#344054" FontWeight="SemiBold">
                <Border Style="{StaticResource SurfaceBorder}" Margin="0,9,0,0" Padding="16,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Host Agent" Style="{StaticResource SecondaryText}" Margin="0,3" />
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="AgentText" Text="Unavailable"
                                   FontWeight="Normal" Margin="0,3" />
                        <TextBlock Grid.Row="1" Text="SMB storage" Style="{StaticResource SecondaryText}" Margin="0,3" />
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SmbText" Text="Unavailable"
                                   FontWeight="Normal" TextWrapping="Wrap" Margin="0,3" />
                        <TextBlock Grid.Row="2" Text="Latency" Style="{StaticResource SecondaryText}" Margin="0,3" />
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="LatencyText" Text="-"
                                   FontWeight="Normal" Margin="0,3" />
                    </Grid>
                </Border>
            </Expander>

            <Grid Grid.Row="4" Margin="2,14,2,0">
                <TextBlock Text="ONLINE requires both the Host Agent and SMB storage."
                           Foreground="#667085" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionText" HorizontalAlignment="Right" Foreground="#98A2B3" FontSize="11" />
            </Grid>
        </Grid>

        <Grid x:Name="EasyModePanel" Visibility="Collapsed" Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/MyOnOff.ico" Width="32" Height="32" Margin="0,0,10,0" />
                    <TextBlock Text="MyOnOff" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <Button x:Name="EasyExitButton" Content="Back to Details" Click="DetailedMode_Click"
                        HorizontalAlignment="Right" Style="{StaticResource ToolbarButton}" MinWidth="116" />
            </Grid>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                <Ellipse x:Name="EasyStatusIndicator" Width="22" Height="22" Fill="#98A2B3"
                         HorizontalAlignment="Center" Margin="0,0,0,18" />
                <TextBlock x:Name="EasyStatusText" Text="Checking status" FontSize="32" FontWeight="SemiBold"
                           TextAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock x:Name="EasyStatusDetailText" Text="Checking the local network."
                           FontSize="15" Foreground="#667085" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,11,0,0" />
                <ProgressBar x:Name="EasyProgress" IsIndeterminate="True" Width="210" Height="6"
                             Margin="0,26,0,0" Visibility="Collapsed" />
                <Button x:Name="EasyOnButton" Content="ON" Click="On_Click" Width="224" Height="100"
                        Margin="0,28,0,0" FontSize="30" FontWeight="Bold" Background="#087A54"
                        Foreground="White" BorderBrush="#087A54" Visibility="Collapsed" />
            </StackPanel>

            <TextBlock Grid.Row="2" x:Name="EasyVersionText" HorizontalAlignment="Center"
                       Foreground="#98A2B3" FontSize="11" />
        </Grid>
    </Grid>
</Window>
