<Window x:Class="MyOnOff.DesktopController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyOnOff" Width="680" Height="610" MinWidth="620" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F7F8FA"
        FontFamily="Segoe UI" Foreground="#101828">
    <Grid>
        <Grid x:Name="NormalModePanel" Margin="32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Host PC" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Local power and storage status" Foreground="#667085" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="EasyModeButton" Content="Easy Mode" Click="EasyMode_Click"
                            MinWidth="104" Margin="0,0,10,0" Background="White" BorderBrush="#D0D5DD" />
                    <Button x:Name="SettingsButton" Content="Settings" Click="Settings_Click"
                            MinWidth="96" Background="#344054" Foreground="White" BorderBrush="#344054" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="0,24,0,16" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusIndicator" Width="20" Height="20" Fill="#98A2B3"
                             Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="StatusText" Text="UNKNOWN" FontSize="25" FontWeight="Bold" />
                        <TextBlock x:Name="DetailsText" Text="Checking the host status."
                                   TextWrapping="Wrap" Foreground="#475467" Margin="0,5,16,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock x:Name="LastRefreshText" Text="Not checked yet" Foreground="#667085"
                                   HorizontalAlignment="Right" />
                        <TextBlock x:Name="IpText" Foreground="#98A2B3" FontSize="12"
                                   HorizontalAlignment="Right" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Readiness" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="HOST AGENT" FontSize="11" Foreground="#667085" FontWeight="SemiBold" />
                            <TextBlock x:Name="AgentText" Text="Unavailable" FontSize="17" FontWeight="SemiBold"
                                       Margin="0,8,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="#EAECF0" Margin="0,2" />
                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="SMB STORAGE" FontSize="11" Foreground="#667085" FontWeight="SemiBold" />
                            <TextBlock x:Name="SmbText" Text="Unavailable" FontSize="17" FontWeight="SemiBold"
                                       Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="3" Background="#EAECF0" Margin="0,2" />
                        <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                            <TextBlock Text="LATENCY" FontSize="11" Foreground="#667085" FontWeight="SemiBold" />
                            <TextBlock x:Name="LatencyText" Text="-" FontSize="17" FontWeight="SemiBold"
                                       Margin="0,8,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="OnButton" Content="ON" Click="On_Click"
                        Height="54" FontSize="17" FontWeight="Bold" Background="#067647" Foreground="White" BorderBrush="#067647" />
                <Button Grid.Column="2" x:Name="SleepButton" Content="Sleep" Click="Sleep_Click"
                        Height="54" FontSize="16" FontWeight="SemiBold" Background="#FEF0C7" BorderBrush="#FEC84B" IsEnabled="False" />
                <Button Grid.Column="4" x:Name="ShutdownButton" Content="Shutdown" Click="Shutdown_Click"
                        Height="54" FontSize="16" FontWeight="SemiBold" Background="#FEE4E2" BorderBrush="#FDA29B" IsEnabled="False" />
            </Grid>

            <Grid Grid.Row="4" Margin="0,14,0,0">
                <TextBlock Text="ONLINE means the Host Agent and SMB storage are ready."
                           Foreground="#667085" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="VersionText" HorizontalAlignment="Right" Foreground="#98A2B3" FontSize="11" />
            </Grid>
        </Grid>

        <Grid x:Name="EasyModePanel" Visibility="Collapsed" Margin="32,26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBlock Text="MyOnOff" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button x:Name="EasyExitButton" Content="Back to Details" Click="DetailedMode_Click"
                        HorizontalAlignment="Right" Background="Transparent" BorderBrush="#D0D5DD" MinWidth="118" />
            </Grid>

            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                <Ellipse x:Name="EasyStatusIndicator" Width="28" Height="28" Fill="#98A2B3"
                         HorizontalAlignment="Center" Margin="0,0,0,20" />
                <TextBlock x:Name="EasyStatusText" Text="Checking status" FontSize="34" FontWeight="Bold"
                           TextAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock x:Name="EasyStatusDetailText" Text="Checking the local network."
                           FontSize="16" Foreground="#667085" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,12,0,0" />
                <ProgressBar x:Name="EasyProgress" IsIndeterminate="True" Width="220" Height="7"
                             Margin="0,28,0,0" Visibility="Collapsed" />
                <Button x:Name="EasyOnButton" Content="ON" Click="On_Click" Width="230" Height="104"
                        Margin="0,30,0,0" FontSize="32" FontWeight="Bold" Background="#067647"
                        Foreground="White" BorderBrush="#067647" Visibility="Collapsed" />
            </StackPanel>

            <TextBlock Grid.Row="2" x:Name="EasyVersionText" HorizontalAlignment="Center"
                       Foreground="#98A2B3" FontSize="11" />
        </Grid>
    </Grid>
</Window>
