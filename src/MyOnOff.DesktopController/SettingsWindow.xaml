<Window x:Class="MyOnOff.DesktopController.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyOnOff Settings" Width="520" Height="700" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#F5F7FA">
    <Grid Margin="22">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="LAN Configuration" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,14" />
        <TextBlock Grid.Row="1" Text="Host IP" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" x:Name="HostIpBox" Margin="0,4" Padding="7" />
        <TextBlock Grid.Row="2" Text="Host MAC" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" x:Name="HostMacBox" Margin="0,4" Padding="7" />
        <TextBlock Grid.Row="3" Text="Broadcast IP" VerticalAlignment="Center" />
        <TextBox Grid.Row="3" Grid.Column="1" x:Name="BroadcastIpBox" Margin="0,4" Padding="7" />
        <TextBlock Grid.Row="4" Text="WOL port" VerticalAlignment="Center" />
        <TextBox Grid.Row="4" Grid.Column="1" x:Name="WolPortBox" Margin="0,4" Padding="7" />
        <TextBlock Grid.Row="5" Text="Agent port" VerticalAlignment="Center" />
        <TextBox Grid.Row="5" Grid.Column="1" x:Name="AgentPortBox" Margin="0,4" Padding="7" />
        <TextBlock Grid.Row="6" Text="SMB port" VerticalAlignment="Center" />
        <TextBox Grid.Row="6" Grid.Column="1" x:Name="SmbPortBox" Margin="0,4" Padding="7" />
        <TextBlock Grid.Row="7" Text="SMB share" VerticalAlignment="Center" />
        <TextBox Grid.Row="7" Grid.Column="1" x:Name="SmbShareBox" Margin="0,4" Padding="7" />
        <TextBlock Grid.Row="8" Text="Expected hostname" VerticalAlignment="Center" />
        <TextBox Grid.Row="8" Grid.Column="1" x:Name="ExpectedHostnameBox" Margin="0,4" Padding="7" />
        <TextBlock Grid.Row="9" Text="Authentication token" VerticalAlignment="Center" />
        <PasswordBox Grid.Row="9" Grid.Column="1" x:Name="AuthTokenBox" Margin="0,4" Padding="7" />

        <CheckBox Grid.Row="10" Grid.ColumnSpan="2" x:Name="StartInEasyModeBox"
                  Content="Start app in Easy Mode" Margin="0,14,0,0" />

        <StackPanel Grid.Row="11" Grid.ColumnSpan="2" Margin="0,14,0,0">
            <TextBlock TextWrapping="Wrap" Foreground="#475467"
                       Text="The token is stored only in your local application-data folder. Use the same value as MYONOFF_AGENT_TOKEN on the Host PC." />
            <TextBlock x:Name="PathText" TextWrapping="Wrap" Foreground="#667085" FontSize="11" Margin="0,8,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="12" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" MinWidth="88" Margin="0,0,10,0" />
            <Button Content="Save" Click="Save_Click" IsDefault="True" MinWidth="88" />
        </StackPanel>
    </Grid>
</Window>
